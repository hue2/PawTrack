@model (int Page, int TotalPages, string? Species, string? City)

<nav class="d-flex gap-2 my-2">
    @if (Model.Page > 1)
    {
        <a class="btn btn-sm btn-outline-secondary" asp-route-p="@(Model.Page - 1)" asp-route-species="@Model.Species" asp-route-city="@Model.City">&laquo; Previous</a>
    }
    @if (Model.Page < Model.TotalPages)
    {
        <a class="btn btn-sm btn-outline-secondary" asp-route-p="@(Model.Page + 1)" asp-route-species="@Model.Species" asp-route-city="@Model.City">Next &raquo;</a>
    }
</nav>
